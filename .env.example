# Salin menjadi .env.local (lokal) atau isi di Environment Variables Vercel.
# Lihat petunjuk pemasangan di apps-script/tracking-api/Tracking.gs

# URL Web App Apps Script (berakhiran /exec) — satu per spreadsheet tracking
TRACKING_GAS_URL_MAHASISWA=
TRACKING_GAS_URL_DOSEN=

# String acak panjang, HARUS sama dengan Script Property TRACKING_API_SECRET di Apps Script
TRACKING_API_SECRET=
